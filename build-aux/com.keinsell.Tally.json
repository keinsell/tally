{
    "app-id": "com.keinsell.Tally",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "counter",
    "separate-locales": false,
    "tags": ["stable"],
    "desktop-file-name-suffix": "",
    "appstream-compose": true,
    "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
    "finish-args": ["--share=ipc", "--socket=fallback-x11", "--socket=wayland", "--device=dri"],
    "cleanup": ["/include", "/lib/pkgconfig", "/share/aclocal", "/share/man", "*.la", "*.a"],
    "x-metadata": {
        "name": "Tally",
        "summary": "Keep track of counts",
        "description": "Tally is a small GNOME application for counting things up and down.",
        "license": "MIT",
        "homepage": "https://github.com/keinsell/tally",
        "bugtracker": "https://github.com/keinsell/tally/issues",
        "developer": "keinsell"
    },
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "build-args": ["--share=network"],
        "env": {"CARGO_NET_OFFLINE": "true", "APP_ID": "com.keinsell.Tally"}
    },
    "modules": [
        {
            "name": "counter",
            "buildsystem": "simple",
            "cleanup": ["/share/app-info"],
            "build-commands": [
                "mkdir -p .cargo && printf '[source.crates-io]\nreplace-with = \"vendored-sources\"\n[source.vendored-sources]\ndirectory = \"cargo/vendor\"\n' > .cargo/config.toml",
                "cargo --offline build --release --locked",
                "install -Dm755 target/release/counter /app/bin/counter",
                "sed \"s/@app-id@/com.keinsell.Tally/g\" data/com.keinsell.Tally.desktop.in > com.keinsell.Tally.desktop",
                "install -Dm644 com.keinsell.Tally.desktop /app/share/applications/com.keinsell.Tally.desktop",
                "sed \"s/@app-id@/com.keinsell.Tally/g\" data/com.keinsell.Tally.metainfo.xml.in > com.keinsell.Tally.metainfo.xml",
                "install -Dm644 com.keinsell.Tally.metainfo.xml /app/share/metainfo/com.keinsell.Tally.metainfo.xml",
                "install -Dm644 data/icons/hicolor/scalable/apps/com.keinsell.Tally.svg /app/share/icons/hicolor/scalable/apps/com.keinsell.Tally.svg",
                "install -Dm644 data/icons/hicolor/symbolic/apps/com.keinsell.Tally-symbolic.svg /app/share/icons/hicolor/symbolic/apps/com.keinsell.Tally-symbolic.svg"
            ],
            "sources": [{"type": "dir", "path": ".."}, "cargo-sources.json"]
        }
    ]
}
